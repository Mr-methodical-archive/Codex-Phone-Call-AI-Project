{
  "name": "ai-call-assistant-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "migrate": "node --loader ts-node/esm src/scripts/migrate.ts",
    "mock:call": "node --loader ts-node/esm src/cli/mockCall.ts"
  },
  "dependencies": {
    "@types/ws": "^8.5.10",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.1.0",
    "openai": "^4.52.3",
    "pino": "^9.1.0",
    "pino-http": "^9.0.0",
    "twilio": "^4.23.2",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pino": "^8.11.3",
    "@types/pino-http": "^6.4.7",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
