# Twilio credentials for live calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional Google Cloud + ElevenLabs keys
ELEVENLABS_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_API_KEY=

# Runtime flags
USE_MOCK=false
MOCK_IVR_PROFILE=telecom-basic
PUBLIC_WS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
PORT=5000
DATABASE_URL=./data/app.db
CALL_MAX_MINUTES=10
WS_HEARTBEAT_MS=10000
AUDIO_CHUNK_MS=200
